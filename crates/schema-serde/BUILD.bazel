load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "schema-serde")

crate_tests(
    compile_data = [
        "//crates/schema-registry:tests/fixtures/rest_err_invalid_schema.json",
        "//crates/schema-registry:tests/fixtures/rest_err_subject_not_found.json",
    ] + glob(["tests/fixtures/**"]),
    lib = "schema-serde",
    manual = ["capture_jvm_fixtures"],
)
