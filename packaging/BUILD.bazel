"""The Schema Registry container image.

apko builds the locked Wolfi base. rules_img adds the Bazel-built registry
binary, loads the image into a local daemon and pushes it to the registry. This
is the path krabka-io/krabka-broker uses.

    bazel run -c opt //packaging:image_load     # load into the local daemon
    bazel run -c opt //packaging:push -- --tag dev

The image carries the server only. `krabka-schema-push` and
`krabka-schema-compat-check` are REST clients. They run on any host that can
reach the registry, so they do not have to be in the image.
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# The tag `image_load` gives the image in the local daemon. A push supplies its
# own tags. See `push` below.
IMAGE_TAG = "ghcr.io/krabka-io/krabka-schema-registry:dev"

# The one architecture that this image is built and published for.
# `base.apko.yaml` names it too, and `image_binaries_test` holds the layer to
# it. A registry binary built for a different CPU cannot go into a manifest
# that declares this one.
IMAGE_ARCH = "amd64"

# The `nonroot` account of the apko base. The chart runs the pod as this user
# and group. The registry binds 8081, which is above 1024, and writes no files.
NONROOT = file_metadata(
    gid = 65532,
    mode = "0755",
    uid = 65532,
)

apko_image(
    name = "base_oci",
    config = "base.apko.yaml",
    contents = "@registry_base_lock//:contents",
    tag = "krabka-schema-registry-base:locked",
)

image_manifest_from_oci_layout(
    name = "base",
    src = ":base_oci",
    architecture = IMAGE_ARCH,
    layers = [GZIP_LAYER],
    os = "linux",
)

image_layer(
    name = "registry_layer",
    srcs = {
        "/usr/bin/krabka-schema-registry": "//crates/schema-registry:krabka-schema-registry",
    },
    default_metadata = NONROOT,
    include_runfiles = False,
)

# The layer holds what the host toolchain built, with no platform transition.
# The manifest declares linux/amd64 always. On a host that is not x86_64 those
# two disagree, and the daemon finds out only when the exec fails. This
# constraint makes Bazel report the target as incompatible at analysis time
# instead, so `bazel build //...` on an aarch64 host skips the image and every
# target that depends on it.
image_manifest(
    name = "image",
    base = ":base",
    entrypoint = ["/usr/bin/krabka-schema-registry"],
    layers = [":registry_layer"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    user = "65532:65532",
)

# `image` puts the manifest and the config in its default outputs, and
# `$(rootpath)` needs exactly one file. `root_blob` is the manifest alone. It
# names the layer digests, and its SHA-256 is the digest of the pushed image.
filegroup(
    name = "image_manifest_blob",
    srcs = [":image"],
    output_group = "root_blob",
)

# Checks the built layer and the manifest that references it: the binary is
# under /usr/bin, it is an ELF for IMAGE_ARCH, and it answers `--help`. It
# needs no daemon, so `bazel test //...` runs it on every pull request.
sh_test(
    name = "image_binaries_test",
    size = "small",
    srcs = ["image_binaries_test.sh"],
    args = [
        IMAGE_ARCH,
        "$(rootpath :image_manifest_blob)",
        "$(rootpath :registry_layer)",
    ],
    data = [
        ":image_manifest_blob",
        ":registry_layer",
    ],
)

image_load(
    name = "image_load",
    image = ":image",
    tag = IMAGE_TAG,
)

# Loads the image into a Docker daemon and runs the entrypoint with `--help`,
# under the base image's own loader and libc. It needs a daemon, so it is
# `manual`: `bazel test //...` skips it, and CI names it on its own.
#
#     bazel test -c opt //packaging:image_docker_test
sh_test(
    name = "image_docker_test",
    size = "medium",
    srcs = ["image_docker_test.sh"],
    args = [
        "$(rootpath :image_load)",
        IMAGE_TAG,
    ],
    data = [":image_load"],
    # `no-sandbox` for the daemon socket. `external` so that Bazel never caches
    # a pass against inputs that do not describe the state of the daemon.
    tags = [
        "external",
        "manual",
        "no-remote-exec",
        "no-sandbox",
    ],
)

# CI supplies the tags on the command line. The `delivery` job in
# //.github/workflows/ci.yml says which tags a push to the default branch
# publishes.
image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-schema-registry",
)
